---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: ImageMetadata
  alt: string
  eager?: boolean
  chrome?: boolean
  sizes?: string
  class?: string
}

const {
  src,
  alt,
  eager = false,
  chrome = true,
  sizes = '(max-width: 1200px) 100vw, 1180px',
  class: className,
} = Astro.props
const widths = [600, 900, 1200, 1600, 2400, 3200].filter(w => w <= src.width)
---

<figure class:list={['frame', className]}>
  {chrome && <div class="chrome" aria-hidden="true"><span></span><span></span><span></span></div>}
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    format="webp"
    quality={88}
  />
</figure>

<style>
  .frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: #1f1f1f;
    box-shadow: var(--shadow);
  }

  .chrome {
    display: flex;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid #2c2c2c;
    background: #262626;
  }

  .chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #4a4a4a;
  }
</style>
