          "Default": {
            "items": {
              "type": "JSON",
              "content": "{\n  \"from\": \"{{fromAccount}}\",\n  \"to\": \"{{toAccount}}\",\n  \"amount\": {{amount}}\n}"
            }
          }
        }
      },
      "SelectedBodyVersion": "Default"
    },
    {
      "Id": "ledger-close-account",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/accounts/{{accountId}}/close",
      "Verb": "POST",
      "Name": "Close account",
      "Description": "",
      "Script": [
        {
          "name": "Default",
