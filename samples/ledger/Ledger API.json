  ],
  "Folders": [],
  "InvariantSuites": [
    {
      "Id": "ledger-suite-money",
      "Name": "Money",
      "Description": "Opens accounts, moves money between them and closes them, in random order, and checks that no money appears or disappears.",
      "Setup": [
        {
          "Id": "ledger-setup-reset",
          "RequestId": "ledger-reset",
          "Name": "Reset"
        }
      ],
      "Actions": [
        {
          "Id": "ledger-action-open",
          "RequestId": "ledger-open-account",
          "Name": "Open account",
          "Weight": 2
        },
        {
          "Id": "ledger-action-transfer",
          "RequestId": "ledger-transfer",
          "Name": "Transfer",
          "Weight": 4
        },
        {
          "Id": "ledger-action-close",
          "RequestId": "ledger-close-account",
          "Name": "Close account",
          "Weight": 1
        },
        {
          "Id": "ledger-action-get",
          "RequestId": "ledger-get-account",
          "Name": "Get account",
          "Weight": 1
        }
      ],
      "Pools": [
        {
          "Name": "accounts",
          "Variables": [
            "accountId"
          ]
        }
      ],
      "Inputs": [
        {
          "Name": "owner",
          "Generator": {
            "Kind": "oneOf",
            "Values": [
              "Ada",
              "Grace",
              "Alan"
            ]
          }
        },
        {
          "Name": "deposit",
          "Generator": {
            "Kind": "decimal",
            "Min": 0,
            "Max": 500,
            "Places": 2
          }
        },
        {
          "Name": "amount",
          "Generator": {
            "Kind": "decimal",
            "Min": 0.01,
            "Max": 200,
            "Places": 2
          }
        },
        {
          "Name": "fromAccount",
          "Generator": {
            "Kind": "fromPool",
            "Pool": "accounts"
          }
        },
        {
          "Name": "toAccount",
          "Generator": {
            "Kind": "fromPool",
            "Pool": "accounts"
          }
        },
        {
          "Name": "accountId",
          "Generator": {
            "Kind": "fromPool",
            "Pool": "accounts"
          }
        }
      ],
      "Rules": [
        {
          "Id": "ledger-rule-money",
          "Name": "money is never created or destroyed",
          "Reads": [
            {
              "Id": "ledger-probe-list",
              "RequestId": "ledger-list-accounts",
              "Name": "List accounts"
            }
          ],
          "Code": "// Money only enters the ledger through deposits, so the total of all balances is what was deposited.\nconst cents = value => Math.round(value * 100)\nif (orpheus.step.action === 'Open account' && orpheus.step.response.status === 201) {\n  orpheus.model.deposited = (orpheus.model.deposited ?? 0) + cents(orpheus.step.response.data.balance)\n}\nconst accounts = orpheus.probes['List accounts'].data.items\nconst total = accounts.reduce((sum, account) => sum + cents(account.balance), 0)\norpheus.expect(total).toBe(orpheus.model.deposited ?? 0)"
        },
        {
          "Id": "ledger-rule-negative",
          "Name": "no balance is negative",
          "Reads": [
            {
              "Id": "ledger-read-negative",
              "RequestId": "ledger-list-accounts",
              "Name": "List accounts"
            }
          ],
          "Code": "for (const account of orpheus.probes['List accounts'].data.items) {\n  orpheus.expect(account.balance).not.toBeLessThan(0)\n}"
        },
        {
          "Id": "ledger-rule-closed",
          "Name": "a closed account stays empty",
          "Reads": [
            {
              "Id": "ledger-read-closed",
              "RequestId": "ledger-list-accounts",
              "Name": "List accounts"
            }
          ],
          "Code": "const closed = orpheus.probes['List accounts'].data.items.filter(account => account.status === 'closed')\nfor (const account of closed) orpheus.expect(account.balance).toBe(0)"
        }
      ],
      "NoServerErrors": true,
      "Settings": {
        "Preset": "quick",
        "Budget": 500,
        "StepsPerSequence": 20
      }
    }
  ],
  "ExecutionPlans": [
    {
      "Id": "ledger-plan-happy-path",
      "Name": "Happy path",
      "Description": "Two accounts and a transfer between them. Passes even with the planted bugs on: they need inputs nobody thinks to try.",
      "Steps": [
        {
          "Id": "ledger-step-reset",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Reset",
          "Kind": "request",
          "RequestId": "ledger-reset"
        },
        {
          "Id": "ledger-step-open",
          "Enabled": true,
          "Repeat": 2,
          "Name": "Open account",
          "Kind": "request",
          "RequestId": "ledger-open-account"
        },
        {
          "Id": "ledger-step-transfer",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Transfer",
          "Kind": "request",
          "RequestId": "ledger-transfer"
        },
        {
          "Id": "ledger-step-list",
          "Enabled": true,
          "Repeat": 1,
          "Name": "List accounts",
          "Kind": "request",
          "RequestId": "ledger-list-accounts"
        }
      ],
      "Settings": {
        "Mode": "serial",
        "Concurrency": 5,
        "Iterations": 1,
        "StopOnFirstFailure": true,
        "DelayMs": 0
      }
    }
  ]
}
