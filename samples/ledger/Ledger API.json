{
  "SchemaVersion": "1.0.0",
  "Id": "col_ledger",
  "Name": "Ledger API",
  "Description": "Accounts and transfers, with bugs planted on purpose. See samples/ledger/README.md.",
  "Variables": {},
  "Auth": {
    "type": "None"
  },
  "Requests": [
    {
      "Id": "ledger-reset",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/reset",
      "Verb": "POST",
      "Name": "Reset",
      "Description": "",
      "Script": [
        {
          "name": "Default",
          "preRequestScript": "",
          "postRequestScript": "orpheus.test('returns 200', () => orpheus.expect(orpheus.response.status).toBe(200))\norpheus.variables.set('accountIds', '[]')"
        }
      ],
      "SelectedScriptVersion": "Default",
      "Variables": {
        "items": {}
      },
      "Auth": {
        "type": "Inherit"
      },
      "Headers": {
        "items": {
          "Accept": "application/json"
        }
      },
      "QueryParams": {
        "items": {}
      },
      "SelectedBodyVersion": ""
    },
    {
      "Id": "ledger-open-account",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/accounts",
      "Verb": "POST",
      "Name": "Open account",
      "Description": "",
      "Script": [
        {
          "name": "Default",
          "preRequestScript": "",
          "postRequestScript": "orpheus.test('returns 201', () => orpheus.expect(orpheus.response.status).toBe(201))\n\n// Remembers every account opened, so a transfer goes from the first to the last.\nconst ids = JSON.parse(orpheus.variables.get('accountIds') ?? '[]')\nids.push(orpheus.response.data.id)\norpheus.variables.set('accountIds', JSON.stringify(ids))\norpheus.variables.set('accountId', orpheus.response.data.id)\norpheus.variables.set('fromAccount', ids[0])\norpheus.variables.set('toAccount', ids[ids.length - 1])"
        }
      ],
      "SelectedScriptVersion": "Default",
      "Variables": {
        "items": {}
      },
      "Auth": {
        "type": "Inherit"
      },
      "Headers": {
        "items": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        }
      },
      "QueryParams": {
        "items": {}
      },
      "Body": {
        "items": {
          "Default": {
            "items": {
              "type": "JSON",
              "content": "{\n  \"owner\": \"{{owner}}\",\n  \"deposit\": {{deposit}}\n}"
            }
          }
        }
      },
      "SelectedBodyVersion": "Default"
    },
    {
      "Id": "ledger-list-accounts",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/accounts",
      "Verb": "GET",
      "Name": "List accounts",
      "Description": "",
      "Script": [
        {
          "name": "Default",
          "preRequestScript": "",
          "postRequestScript": "orpheus.test('returns 200', () => orpheus.expect(orpheus.response.status).toBe(200))\n\norpheus.test('no balance is negative', () => {\n  for (const account of orpheus.response.data.items) {\n    orpheus.expect(account.balance).not.toBeLessThan(0)\n  }\n})"
        }
      ],
      "SelectedScriptVersion": "Default",
      "Variables": {
        "items": {}
      },
      "Auth": {
        "type": "Inherit"
      },
      "Headers": {
        "items": {
          "Accept": "application/json"
        }
      },
      "QueryParams": {
        "items": {}
      },
      "SelectedBodyVersion": ""
    },
    {
      "Id": "ledger-get-account",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/accounts/{{accountId}}",
      "Verb": "GET",
      "Name": "Get account",
      "Description": "",
      "Script": [
        {
          "name": "Default",
          "preRequestScript": "",
          "postRequestScript": "orpheus.test('returns 200', () => orpheus.expect(orpheus.response.status).toBe(200))"
        }
      ],
      "SelectedScriptVersion": "Default",
      "Variables": {
        "items": {}
      },
      "Auth": {
        "type": "Inherit"
      },
      "Headers": {
        "items": {
          "Accept": "application/json"
        }
      },
      "QueryParams": {
        "items": {}
      },
      "SelectedBodyVersion": ""
    },
    {
      "Id": "ledger-transfer",
      "VerifySSL": true,
      "TimeoutMs": 0,
      "URL": "{{baseUrl}}/transfers",
      "Verb": "POST",
      "Name": "Transfer",
      "Description": "",
      "Script": [
        {
          "name": "Default",
          "preRequestScript": "",
          "postRequestScript": "orpheus.test('returns 201', () => orpheus.expect(orpheus.response.status).toBe(201))"
        }
      ],
      "SelectedScriptVersion": "Default",
      "Variables": {
        "items": {}
      },
      "Auth": {
