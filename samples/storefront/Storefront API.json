        {
          "VerifySSL": true,
          "TimeoutMs": 0,
          "URL": "{{baseUrl}}/{{apiVersion}}/orders",
          "Verb": "GET",
          "Name": "List open orders",
          "Description": "",
          "Script": [
            {
              "name": "Smoke",
              "preRequestScript": "",
              "postRequestScript": "orpheus.test('returns 200', () => {\n  orpheus.expect(orpheus.response.status).toBe(200)\n})\n\norpheus.test('only open orders', () => {\n  for (const order of orpheus.response.data.items) {\n    orpheus.expect(order.status).toBe('open')\n  }\n})\n\norpheus.variables.set('orderId', orpheus.response.data.items[0].id)"
            },
            {
              "name": "Contract",
              "preRequestScript": "orpheus.request.headers['X-Request-Id'] = String(Date.now())",
              "postRequestScript": "const schema = {\n  type: 'object',\n  required: ['items', 'total'],\n  properties: {\n    total: { type: 'integer' },\n    items: { type: 'array', items: { type: 'object', required: ['id', 'status', 'total'] } },\n  },\n}\n\norpheus.test('matches the contract', () => {\n  orpheus.expect(orpheus.response.data).toMatchSchema(schema)\n})"
            }
          ],
          "SelectedScriptVersion": "Smoke",
          "Variables": {
            "items": {}
          },
          "Auth": {
            "type": "Inherit"
          },
          "Headers": {
            "items": {
              "Accept": "application/json"
            }
          },
          "QueryParams": {
            "items": {
              "status": "open",
              "limit": "{{pageSize}}"
            }
          },
          "SelectedBodyVersion": ""
        },
