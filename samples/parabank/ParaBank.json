  "Folders": [],
  "InvariantSuites": [
    {
      "Id": "parabank-suite-money",
      "Name": "Money",
      "Description": "Moves money around John's accounts in random ways, and checks the bank stays readable and keeps its sums.",
      "Setup": [
        {
          "Id": "parabank-setup-initialize",
          "RequestId": "parabank-initialize",
          "Name": "Initialize database"
        },
        {
          "Id": "parabank-setup-login",
          "RequestId": "parabank-login",
          "Name": "Log in"
        },
        {
          "Id": "parabank-setup-accounts",
          "RequestId": "parabank-list-accounts",
          "Name": "List accounts"
        }
      ],
      "Actions": [
        {
          "Id": "parabank-action-transfer",
          "RequestId": "parabank-transfer",
          "Name": "Transfer",
          "Weight": 4
        },
        {
          "Id": "parabank-action-deposit",
          "RequestId": "parabank-deposit",
          "Name": "Deposit",
          "Weight": 1
        },
        {
          "Id": "parabank-action-withdraw",
          "RequestId": "parabank-withdraw",
          "Name": "Withdraw",
          "Weight": 1
        },
        {
          "Id": "parabank-action-open",
          "RequestId": "parabank-open-account",
          "Name": "Open account",
          "Weight": 1
        },
        {
          "Id": "parabank-action-get",
          "RequestId": "parabank-get-account",
          "Name": "Get account",
          "Weight": 1
        }
      ],
      "Pools": [
        {
          "Name": "accounts",
          "Variables": [
            "fromAccountId",
            "toAccountId",
            "accountId"
          ]
        }
      ],
      "Inputs": [
        {
          "Name": "amount",
          "Generator": {
            "Kind": "decimal",
            "Min": 0.01,
            "Max": 500,
            "Places": 2
          }
        },
        {
          "Name": "fromAccountId",
          "Generator": {
            "Kind": "fromPool",
            "Pool": "accounts"
          }
        },
        {
          "Name": "toAccountId",
          "Generator": {
            "Kind": "fromPool",
            "Pool": "accounts"
          }
        }
      ],
      "Rules": [
        {
          "Id": "parabank-rule-money",
          "Name": "money only changes with deposits and withdrawals",
          "Reads": [
            {
              "Id": "parabank-probe-accounts",
              "RequestId": "parabank-list-accounts",
              "Name": "List accounts"
            }
          ],
          "Code": "// Transfers and new accounts move money around; only deposits and withdrawals change the total.\nconst cents = value => Math.round(Number(value) * 100)\nconst step = orpheus.step\nconst total = orpheus.probes['List accounts'].data.reduce((sum, account) => sum + cents(account.balance), 0)\nconst done = step.response.status === 200\nconst change = !done ? 0\n  : step.action === 'Deposit' ? cents(step.inputs.amount)\n  : step.action === 'Withdraw' ? -cents(step.inputs.amount)\n  : 0\nif (orpheus.model.total !== undefined) orpheus.expect(total).toBe(orpheus.model.total + change)\norpheus.model.total = total"
        }
      ],
      "NoServerErrors": true,
      "Settings": {
        "Preset": "quick",
        "Budget": 500,
        "StepsPerSequence": 20
      }
    }
  ],
  "ExecutionPlans": [
    {
      "Id": "parabank-plan-happy-path",
      "Name": "Happy path",
      "Steps": [
        {
          "Id": "parabank-step-1",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Initialize database",
          "Kind": "request",
          "RequestId": "parabank-initialize"
        },
        {
          "Id": "parabank-step-2",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Log in",
          "Kind": "request",
          "RequestId": "parabank-login"
        },
        {
          "Id": "parabank-step-3",
          "Enabled": true,
          "Repeat": 1,
          "Name": "List accounts",
          "Kind": "request",
          "RequestId": "parabank-list-accounts"
        },
        {
          "Id": "parabank-step-4",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Transfer",
          "Kind": "request",
          "RequestId": "parabank-transfer"
        },
        {
          "Id": "parabank-step-5",
          "Enabled": true,
          "Repeat": 1,
          "Name": "Get account",
          "Kind": "request",
          "RequestId": "parabank-get-account"
        }
      ],
      "Settings": {
        "Mode": "serial",
        "Concurrency": 5,
        "Iterations": 1,
        "StopOnFirstFailure": true,
        "DelayMs": 0
      }
    }
  ]
